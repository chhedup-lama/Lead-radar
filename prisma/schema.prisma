generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Source {
  id          String   @id @default(cuid())
  name        String
  url         String   @unique
  tier        Int      @default(1)
  category    String?
  status      String   @default("untested")
  statusNote  String?
  lastTested  DateTime?
  lastScanned DateTime?
  createdAt   DateTime @default(now())
}
